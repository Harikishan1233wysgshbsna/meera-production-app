/** Read-only admin dashboard sources. Add to TEST and integrate the separate patch.
 * Configure ADMIN_PLUG_CONFIG in Script Properties. No IDs or credentials in code.
 * All source reads require the existing requireAdmin_() session check.
 * Only the separately configured control spreadsheet may receive annotations.
 */
function adminPlugConfig_(){var raw=PropertiesService.getScriptProperties().getProperty('ADMIN_PLUG_CONFIG');if(!raw)throw new Error('Admin plug is not configured. Set ADMIN_PLUG_CONFIG privately.');var c=JSON.parse(raw);if(!Array.isArray(c.sources)||c.sources.length>12)throw new Error('Invalid source configuration.');return c;}
function adminPlugSource_(key){var s=adminPlugConfig_().sources.filter(function(s){return s.key===key;});if(s.length!==1)throw new Error('Unknown or repeated source key.');return s[0];}
function adminPlugSheet_(source){if(!source.spreadsheetId||!source.sheetName)throw new Error('Confirm the exact workbook and tab first.');var ss=SpreadsheetApp.openById(source.spreadsheetId),sheet=ss.getSheetByName(source.sheetName);if(!sheet)throw new Error('Tab not found: '+source.sheetName+'. Choose the exact tab in config; no automatic substitution is made.');return sheet;}
function adminPlugMeta_(p){var user=requireAdmin_(p.token),cfg=adminPlugConfig_();return {ok:true,user:{username:user.username,name:user.name,role:user.role},timezone:'Asia/Calcutta',sources:cfg.sources.map(function(s){try{var sh=adminPlugSheet_(s);return {key:s.key,type:s.type,title:s.title||s.sheetName,tab:sh.getName(),sheetId:sh.getSheetId(),url:'https://docs.google.com/spreadsheets/d/'+s.spreadsheetId+'/edit#gid='+sh.getSheetId(),headerRow:Number(s.headerRow)||1,dataStart:Number(s.dataStart)||((Number(s.headerRow)||1)+1),lastRow:sh.getLastRow(),columns:Math.min(Number(s.columns)||32,43),orderSourceConfirmed:s.orderSourceConfirmed===true};}catch(e){return {key:s.key,type:s.type,title:s.title||s.sheetName,error:String(e.message||e)};}}),chatConfigured:!!cfg.whatsappDocId,controlConfigured:!!cfg.controlSpreadsheetId};}
function adminPlugDate_(value){if(value instanceof Date&&!isNaN(value.getTime()))return Utilities.formatDate(value,'Asia/Calcutta','yyyy-MM-dd');if(typeof value==='number')return Utilities.formatDate(new Date((value-25569)*86400000),'UTC','yyyy-MM-dd');var s=String(value||'').trim(),m=s.match(/^(\d{4})-(\d{2})-(\d{2})/);if(m)return m[1]+'-'+m[2]+'-'+m[3];m=s.match(/^(\d{1,2})[\/.\-](\d{1,2})[\/.\-](\d{2}|\d{4})(?:$|\s)/);if(!m)return '';return (m[3].length===2?'20'+m[3]:m[3])+'-'+('0'+m[2]).slice(-2)+'-'+('0'+m[1]).slice(-2);}
function adminPlugPage_(p){
 requireAdmin_(p.token);var s=adminPlugSource_(String(p.kind||'')),sheet=adminPlugSheet_(s),headerRow=Number(s.headerRow)||1,dataStart=Number(s.dataStart)||(headerRow+1),width=Math.min(Number(s.columns)||32,43),last=sheet.getLastRow(),start=Number(p.startRow)||dataStart,limit=Math.min(Math.max(Number(p.limit)||1000,1),1000);
 if(!Number.isInteger(start)||start<dataStart)throw new Error('Invalid page cursor.');var from=String(p.from||''),to=String(p.to||'');if(from&&!/^\d{4}-\d{2}-\d{2}$/.test(from)||to&&!/^\d{4}-\d{2}-\d{2}$/.test(to))throw new Error('Invalid date filter.');
 var headers=sheet.getRange(headerRow,1,1,width).getDisplayValues()[0],count=Math.max(0,Math.min(limit,last-start+1)),rows=[],numbers=[],invalidDates=0;
 if(count){var range=sheet.getRange(start,1,count,width),display=range.getDisplayValues(),values=range.getValues(),dateColumn=Number(s.dateColumn)||0;
  display.forEach(function(row,i){if(!row.some(function(v){return String(v).trim();}))return;var day=dateColumn?adminPlugDate_(values[i][dateColumn-1]):'';if(dateColumn){if(!day)invalidDates++;else row[dateColumn-1]=day;}
   // Orders are lifecycle records; always read their full configured table.
   if(s.type!=='orders'&&day&&(from&&day<from||to&&day>to))return;
   rows.push(row);numbers.push(start+i);
  });
 }
 var next=start+count<=last?start+count:null;return {ok:true,key:s.key,type:s.type,title:s.title||s.sheetName,tab:s.sheetName,rows:[headers].concat(rows),rowNumbers:numbers,headerIndex:0,startRow:start-1,nextRow:next,lastRow:last,scannedThrough:Math.min(start+count-1,last),complete:next===null,filterFrom:s.type==='orders'?'':from,filterTo:s.type==='orders'?'':to,invalidDates:invalidDates,orderSourceConfirmed:s.orderSourceConfirmed===true};
}
function adminPlugChat_(p){requireAdmin_(p.token);var cfg=adminPlugConfig_();if(!cfg.whatsappDocId)return {ok:true,configured:false,text:''};var doc=DocumentApp.openById(cfg.whatsappDocId),value=doc.getBody().getText();if(value.length>1500000)throw new Error('Chat export too large; import a date-bounded local export.');return {ok:true,configured:true,title:doc.getName(),text:value,complete:false};}
function adminPlugControl_(){var cfg=adminPlugConfig_();if(cfg.sources.some(function(s){return s.spreadsheetId===cfg.controlSpreadsheetId;}))throw new Error('Control workbook must differ from production/order sources.');if(!cfg.controlSpreadsheetId)throw new Error('Configure a separate private control spreadsheet before saving admin notes.');var sheet=SpreadsheetApp.openById(cfg.controlSpreadsheetId).getSheetByName('ADMIN PLUG AUDIT');if(!sheet)throw new Error('Run adminPlugInitializeControl manually in the configured control workbook.');var headers=sheet.getRange(1,1,1,5).getDisplayValues()[0],expected=['CHANGE ID','RECORD KEY','ANNOTATION JSON','UPDATED AT','ADMIN'];if(expected.some(function(v,i){return headers[i]!==v;}))throw new Error('Control ledger headers differ; no write attempted.');return sheet;}
function adminPlugInitializeControl(){var cfg=adminPlugConfig_();if(!cfg.controlSpreadsheetId)throw new Error('Set a separate private controlSpreadsheetId.');if(cfg.sources.some(function(s){return s.spreadsheetId===cfg.controlSpreadsheetId;}))throw new Error('Control workbook must differ from all production/order source workbooks.');var ss=SpreadsheetApp.openById(cfg.controlSpreadsheetId),sheet=ss.getSheetByName('ADMIN PLUG AUDIT');if(!sheet){sheet=ss.insertSheet('ADMIN PLUG AUDIT');sheet.appendRow(['CHANGE ID','RECORD KEY','ANNOTATION JSON','UPDATED AT','ADMIN']);}return {ok:true};}
function adminPlugAnnotations_(p){requireAdmin_(p.token);var cfg=adminPlugConfig_();if(!cfg.controlSpreadsheetId)return {ok:true,annotations:{},configured:false};var sh=adminPlugControl_(),last=sh.getLastRow(),start=Math.max(2,last-4999),count=Math.max(0,last-start+1),state=Object.create(null);if(count)sh.getRange(start,1,count,5).getDisplayValues().forEach(function(r){try{state[r[1]]=JSON.parse(r[2]);}catch(ignored){}});return {ok:true,annotations:state,truncated:start>2,configured:true};}
function adminPlugAnnotate_(body){var user=requireAdmin_(body.token),key=String(body.key||''),changeId=String(body.changeId||''),input=body.annotation||{};if(/^[=+\-@\t\r]/.test(key))throw new Error('Unsafe annotation key.');if(!key||['__proto__','constructor','prototype'].indexOf(key)>=0||key.length>500||!/^[A-Za-z0-9-]{16,100}$/.test(changeId))throw new Error('Invalid annotation identity.');var annotation={changeId:changeId,note:String(input.note||'').slice(0,1500),orderKey:String(input.orderKey||'').slice(0,250),state:String(input.state||'').slice(0,40),updatedBy:user.username,updatedAt:new Date().toISOString()};if(annotation.state&&!['OPEN','REVIEW_REQUIRED','VERIFIED_COMPLETE'].includes(annotation.state))throw new Error('Unsupported review state.');var lock=LockService.getScriptLock();lock.waitLock(10000);try{var sh=adminPlugControl_(),found=sh.getRange(1,1,Math.max(1,sh.getLastRow()),1).createTextFinder(changeId).matchEntireCell(true).findNext();if(!found){sh.appendRow([changeId,key,JSON.stringify(annotation),new Date(),user.username]);SpreadsheetApp.flush();}return {ok:true,changeId:changeId};}finally{lock.releaseLock();}}

function adminPlugChange_(p){requireAdmin_(p.token);var id=String(p.changeId||'');if(!/^[A-Za-z0-9-]{16,100}$/.test(id))throw new Error('Invalid change identity.');var sh=adminPlugControl_(),found=sh.getRange(1,1,Math.max(1,sh.getLastRow()),1).createTextFinder(id).matchEntireCell(true).findNext();if(!found)return {ok:true,found:false};var row=sh.getRange(found.getRow(),1,1,5).getDisplayValues()[0];return {ok:true,found:true,changeId:row[0],key:row[1],annotation:JSON.parse(row[2])};}
