{
  "name": "rc5-native-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "sync": "npm run build && cap sync && node scripts/pin-ios.mjs",
    "android": "cap open android",
    "ios": "cap open ios",
    "mock": "node scripts/mock-server.mjs",
    "test:browser": "playwright test",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "^1.65.1",
    "vite": "^7.2.2"
  }
}
